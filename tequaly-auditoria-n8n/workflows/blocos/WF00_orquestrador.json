              "value": "={{ $json.periodoInicio ?? '' }}"
            },
            {
              "id": "n3",
              "name": "periodoFim",
              "type": "string",
              "value": "={{ $json.periodoFim ?? '' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a7e9eb63-56c2-4695-83ee-88c8cc4cad2b",
      "name": "Normalizar entrada",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        96
      ],
      "notes": "Os dois gatilhos viram o mesmo formato. Datas vazias seguem vazias: o WF30 aplica o padrão de 30 dias."
    },
    {
      "parameters": {
        "formTitle": "Rodar pipeline de auditoria",
        "formDescription": "Valida chaves, extrai dados, calcula KPIs e envia o relatório. Datas em branco = últimos 30 dias.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "periodoInicio",
              "fieldType": "date"
            },
            {
              "fieldLabel": "periodoFim",
              "fieldType": "date"
            }
          ]
        },
        "options": {
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Pipeline iniciado. Acompanhe em pipeline_log."
            }
          }
        }
      },
      "id": "84dfd716-1084-4d10-b460-43449459e983",
      "name": "Rodar pipeline manualmente",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        192
      ],
      "webhookId": "92568bbe-de4c-4cf3-831a-7adb90946f34"
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "DRJgzvtmM7n8UpNz",
          "cachedResultName": "WF10 - Validar chaves das fontes"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "attemptToConvertTypes": false,
