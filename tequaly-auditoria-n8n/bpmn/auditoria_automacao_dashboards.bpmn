<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Tequaly_Auditoria" targetNamespace="http://tequaly.com.br/bpmn/auditoria" exporter="Tequaly - Processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_Auditoria">
    <bpmn:participant id="Participant_Projeto" name="Projeto: Automação de Dashboards da Auditoria (Tequaly)" processRef="Process_AutomacaoDashboards" />
    <bpmn:group id="Group_Fase1" categoryValueRef="CategoryValue_Fase1" />
    <bpmn:group id="Group_Fase2" categoryValueRef="CategoryValue_Fase2" />
    <bpmn:group id="Group_Fase3" categoryValueRef="CategoryValue_Fase3" />
    <bpmn:group id="Group_Fase4" categoryValueRef="CategoryValue_Fase4" />
    <bpmn:group id="Group_Fase5" categoryValueRef="CategoryValue_Fase5" />
    <bpmn:group id="Group_Fase6" categoryValueRef="CategoryValue_Fase6" />
  </bpmn:collaboration>
  <bpmn:category id="Category_Fases">
    <bpmn:categoryValue id="CategoryValue_Fase1" value="1. Descoberta e Análise" />
    <bpmn:categoryValue id="CategoryValue_Fase2" value="2. Acesso aos Dados" />
    <bpmn:categoryValue id="CategoryValue_Fase3" value="3. Desenho TO-BE" />
    <bpmn:categoryValue id="CategoryValue_Fase4" value="4. Construção (DEV)" />
    <bpmn:categoryValue id="CategoryValue_Fase5" value="5. Homologação (HML)" />
    <bpmn:categoryValue id="CategoryValue_Fase6" value="6. Produção (PRD) e Entrega" />
  </bpmn:category>
  <bpmn:process id="Process_AutomacaoDashboards" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Auditoria" name="Auditoria (Solicitante)">
        <bpmn:flowNodeRef>StartEvent_Demanda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidarTOBE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TOBE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UAT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Aceite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PosImpl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Entregue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Analista" name="Analista de Processos / Automação">
        <bpmn:flowNodeRef>Task_Backlog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Workshop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inventario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Requisitos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Postman</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TOBE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DevN8N</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DevDash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Testes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Testes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HML</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PRD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Entrega</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TI" name="TI / Dono do Sistema Interno">
        <bpmn:flowNodeRef>Task_AvaliarAcesso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_API</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CredAPI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReplicaBD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinAcesso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GMUD</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Plataforma" name="Plataforma (n8n · Git · Postman · BD · Dashboard)">
        <bpmn:flowNodeRef>Service_ETL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_Refresh</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Demanda" name="Demanda de automação recebida">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Backlog" name="Registrar demanda no backlog e abrir projeto">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Workshop" name="Conduzir entrevistas e workshop de descoberta">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ASIS" name="Mapear processo AS-IS no Bizagi (BPMN 2.0)">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Inventario" name="Inventariar relatórios, fontes de dados e KPIs">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Requisitos" name="Especificar requisitos, regras e critérios de aceite">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_AvaliarAcesso" name="Avaliar formas de acesso ao sistema interno">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_API" name="Sistema expõe API REST?">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CredAPI" name="Emitir credenciais de API por ambiente (DEV/HML/PRD)">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReplicaBD" name="Liberar réplica de BD read-only ou export agendado">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_JoinAcesso">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Postman" name="Mapear e testar endpoints/consultas no Postman">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_TOBE" name="Modelar TO-BE e arquitetura de dados">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_ValidarTOBE" name="Validar TO-BE e protótipo de KPIs">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_TOBE" name="TO-BE aprovado?">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_DevN8N" name="Desenvolver workflows n8n em DEV (versionado no Git)">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DevDash" name="Desenvolver modelo de dados e dashboard em DEV">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Testes" name="Executar testes técnicos (Postman, dados, erros)">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Testes" name="Testes OK?">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_HML" name="Promover para HML (merge, tag, deploy HML)">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_UAT" name="Homologar (UAT) com dados reais">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Aceite" name="Aceite formal?">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_GMUD" name="Aprovar mudança (GMUD) e janela de deploy">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_PRD" name="Publicar em PRD, ativar agendamentos e monitoramento">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Service_ETL" name="n8n PRD: extrair, transformar e carregar dados">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Service_Refresh" name="Atualizar datasets e dashboard (refresh / realtime)">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Task_Entrega" name="Entregar dashboard, documentação e treinamento">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_PosImpl" name="Operar dashboard e validar pós-implantação">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Entregue" name="Dashboard entregue em produção">
      <bpmn:incoming>Flow_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Demanda" targetRef="Task_Backlog" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Backlog" targetRef="Task_Workshop" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_Workshop" targetRef="Task_ASIS" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ASIS" targetRef="Task_Inventario" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_Inventario" targetRef="Task_Requisitos" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_Requisitos" targetRef="Task_AvaliarAcesso" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_AvaliarAcesso" targetRef="Gateway_API" />
    <bpmn:sequenceFlow id="Flow_08" name="Sim" sourceRef="Gateway_API" targetRef="Task_CredAPI" />
    <bpmn:sequenceFlow id="Flow_09" name="Não" sourceRef="Gateway_API" targetRef="Task_ReplicaBD" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_CredAPI" targetRef="Gateway_JoinAcesso" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ReplicaBD" targetRef="Gateway_JoinAcesso" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_JoinAcesso" targetRef="Task_Postman" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Postman" targetRef="Task_TOBE" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_TOBE" targetRef="Task_ValidarTOBE" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ValidarTOBE" targetRef="Gateway_TOBE" />
    <bpmn:sequenceFlow id="Flow_16" name="Sim" sourceRef="Gateway_TOBE" targetRef="Task_DevN8N" />
    <bpmn:sequenceFlow id="Flow_17" name="Não" sourceRef="Gateway_TOBE" targetRef="Task_Requisitos" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_DevN8N" targetRef="Task_DevDash" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_DevDash" targetRef="Task_Testes" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_Testes" targetRef="Gateway_Testes" />
    <bpmn:sequenceFlow id="Flow_21" name="Sim" sourceRef="Gateway_Testes" targetRef="Task_HML" />
    <bpmn:sequenceFlow id="Flow_22" name="Não" sourceRef="Gateway_Testes" targetRef="Task_DevN8N" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_HML" targetRef="Task_UAT" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_UAT" targetRef="Gateway_Aceite" />
    <bpmn:sequenceFlow id="Flow_25" name="Sim" sourceRef="Gateway_Aceite" targetRef="Task_GMUD" />
    <bpmn:sequenceFlow id="Flow_26" name="Não" sourceRef="Gateway_Aceite" targetRef="Task_DevN8N" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_GMUD" targetRef="Task_PRD" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_PRD" targetRef="Service_ETL" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Service_ETL" targetRef="Service_Refresh" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Service_Refresh" targetRef="Task_Entrega" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_Entrega" targetRef="Task_PosImpl" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_PosImpl" targetRef="EndEvent_Entregue" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Auditoria">
